    "traceRegex": ".*Connection.*|.*ConnectTimeout.*|.*ReadTimeout.*|.*Timeout.*|.*ProtocolError.*|.*ConnectionResetError.*"
  },
  {
    "name": "Серверные ошибки 5xx",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": ".*500.*|.*502.*|.*503.*|.*504.*|.*Internal Server Error.*",
